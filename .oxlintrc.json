{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "unicorn", "react", "jsx-a11y", "nextjs", "import"],
  "categories": { "correctness": "error" },
  "env": { "builtin": true, "browser": true, "node": true, "es2024": true },
  "jsPlugins": ["eslint-plugin-security", "eslint-plugin-better-tailwindcss", "eslint-plugin-simple-import-sort"],
  "settings": {
    "better-tailwindcss": {
      "entryPoint": "src/app/globals.css"
    }
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.next/**",
    "**/out/**",
    "**/build/**",
    "**/dist/**",
    "**/.turbo/**",
    "**/coverage/**",
    "**/.vitest/**",
    "**/backups/**",
    "**/.claude/**",
    "next-env.d.ts",
    "**/*.d.ts",
    "public/**",
    "vite.config.ts",
    "vitest.config.ts",
    "jest.config.ts",
    "postcss.config.mjs",
    "scripts/**/*.js",
    "docs/**/*.mjs"
  ],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "no-console": ["warn", { "allow": ["warn", "error", "info"] }],
    "no-debugger": "warn",
    "prefer-const": "error",
    "no-var": "error",
    "object-shorthand": "error",
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-unneeded-ternary": "error",

    "max-lines-per-function": ["error", { "max": 75, "skipBlankLines": true, "skipComments": true, "IIFEs": true }],
    "complexity": ["error", { "max": 10 }],
    "max-params": ["error", { "max": 4 }],
    "max-depth": ["error", { "max": 3 }],

    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/ban-ts-comment": [
      "error",
      { "ts-expect-error": "allow-with-description", "ts-ignore": true, "ts-nocheck": true }
    ],
    "typescript/explicit-module-boundary-types": "off",
    "typescript/consistent-type-imports": ["error", { "prefer": "type-imports" }],
    "typescript/no-empty-interface": "warn",
    "typescript/no-inferrable-types": "warn",

    "react/react-in-jsx-scope": "off",
    "react/self-closing-comp": "error",
    "react/jsx-curly-brace-presence": ["error", { "props": "never", "children": "never" }],
    "react/jsx-boolean-value": ["error", "never"],
    "react/jsx-no-target-blank": "error",
    "react/no-array-index-key": "warn",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",

    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-is-valid": [
      "error",
      {
        "components": ["Link"],
        "specialLink": ["hrefLeft", "hrefRight"],
        "aspects": ["invalidHref", "preferButton"]
      }
    ],
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-proptypes": "error",
    "jsx-a11y/aria-unsupported-elements": "error",
    "jsx-a11y/role-has-required-aria-props": "error",
    "jsx-a11y/role-supports-aria-props": "error",
    "jsx-a11y/heading-has-content": ["error", { "components": ["Heading"] }],

    "nextjs/no-html-link-for-pages": "error",
    "nextjs/no-img-element": "warn",
    "nextjs/no-head-import-in-document": "error",
    "nextjs/no-sync-scripts": "error",
    "nextjs/no-script-component-in-head": "error",

    "import/no-duplicates": "error",
    "import/first": "error",
    "import/newline-after-import": "error",
    "import/no-anonymous-default-export": "warn",

    "simple-import-sort/exports": "error",
    "simple-import-sort/imports": [
      "error",
      {
        "groups": [
          ["^\\u0000"],
          ["^node:"],
          ["^react$", "^react/"],
          ["^next$", "^next/"],
          ["^@?\\w"],
          ["^@/"],
          ["^\\.\\.(?!/?$)", "^\\.\\./?$"],
          ["^\\./(?=.*/)(?!/?$)", "^\\.(?!/?$)", "^\\./?$"]
        ]
      }
    ],

    "func-style": ["error", "expression", { "allowArrowFunctions": true }],
    "prefer-arrow-callback": "error",

    "security/detect-buffer-noassert": "warn",
    "security/detect-child-process": "warn",
    "security/detect-disable-mustache-escape": "warn",
    "security/detect-eval-with-expression": "warn",
    "security/detect-new-buffer": "warn",
    "security/detect-no-csrf-before-method-override": "warn",
    "security/detect-non-literal-fs-filename": "warn",
    "security/detect-non-literal-regexp": "warn",
    "security/detect-non-literal-require": "warn",
    "security/detect-object-injection": "warn",
    "security/detect-possible-timing-attacks": "warn",
    "security/detect-pseudoRandomBytes": "warn",
    "security/detect-unsafe-regex": "warn",
    "security/detect-bidi-characters": "warn",

    "better-tailwindcss/no-conflicting-classes": "off",
    "better-tailwindcss/no-duplicate-classes": "off",
    "better-tailwindcss/no-deprecated-classes": "off",
    "better-tailwindcss/no-unknown-classes": "off"
  },
  "overrides": [
    {
      "files": ["src/app/**/*.js", "src/app/**/*.jsx", "src/app/**/*.ts", "src/app/**/*.tsx"],
      "rules": {
        "better-tailwindcss/no-conflicting-classes": "error",
        "better-tailwindcss/no-duplicate-classes": "error",
        "better-tailwindcss/no-deprecated-classes": "error",
        "better-tailwindcss/no-unknown-classes": [
          "error",
          {
            "ignore": ["^cn-", "^toaster$"]
          }
        ]
      }
    },
    {
      "files": ["**/*.spec.js", "**/*.spec.jsx", "**/*.spec.ts", "**/*.spec.tsx"],
      "rules": { "better-tailwindcss/no-unknown-classes": "off" }
    },
    {
      "files": ["*.config.js", "*.config.mjs", "*.config.ts"],
      "rules": { "import/no-anonymous-default-export": "off" }
    },
    {
      "files": ["**/components/**/*.tsx", "**/app/**/*.tsx", "**/*.component.tsx"],
      "rules": {
        "max-lines-per-function": ["error", { "max": 250, "skipBlankLines": true, "skipComments": true }]
      }
    },
    {
      "files": [
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "e2e/**",
        "scripts/**/*.ts",
        "scripts/**/*.tsx",
        "**/test-utils/**",
        "tests/**"
      ],
      "rules": { "max-lines-per-function": "off" }
    },
    {
      "files": ["src/app/components/ui/chart.tsx"],
      "rules": { "max-params": "off" }
    },
    {
      "files": [
        "**/page.tsx",
        "**/layout.tsx",
        "**/loading.tsx",
        "**/error.tsx",
        "**/global-error.tsx",
        "**/not-found.tsx",
        "**/template.tsx",
        "**/default.tsx",
        "**/route.ts",
        "**/middleware.ts",
        "**/instrumentation.ts",
        "**/manifest.ts",
        "**/sitemap.ts",
        "**/robots.ts",
        "**/opengraph-image.tsx",
        "**/icon.tsx",
        "**/apple-icon.tsx"
      ],
      "rules": { "func-style": "off" }
    },
    {
      "files": ["src/app/components/ui/**"],
      "excludeFiles": ["src/app/components/ui/**/*.spec.tsx"],
      "rules": { "func-style": "off" }
    },
    {
      "files": [
        "src/app/components/ui/breadcrumb.tsx",
        "src/app/components/ui/button-group.tsx",
        "src/app/components/ui/carousel.tsx",
        "src/app/components/ui/field.tsx",
        "src/app/components/ui/input-group.tsx",
        "src/app/components/ui/input-otp.tsx",
        "src/app/components/ui/item.tsx",
        "src/app/components/ui/spinner.tsx"
      ],
      "rules": { "jsx-a11y/prefer-tag-over-role": "off" }
    },
    {
      "files": ["src/app/components/ui/label.tsx"],
      "rules": { "jsx-a11y/label-has-associated-control": "off" }
    },
    {
      "files": ["src/app/components/ui/pagination.tsx"],
      "rules": { "jsx-a11y/anchor-has-content": "off" }
    },
    {
      "files": ["src/app/components/ui/input-group.tsx"],
      "rules": {
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off"
      }
    },
    {
      "files": ["src/app/components/ui/chart.tsx", "src/app/components/ui/input-otp.tsx"],
      "rules": { "security/detect-object-injection": "off" }
    },
    {
      "files": ["src/app/components/ui/chart.tsx", "src/app/components/ui/sidebar.tsx"],
      "rules": { "complexity": "off" }
    },
    {
      "files": ["src/app/components/ui/chart.tsx"],
      "rules": { "react/no-array-index-key": "off" }
    },
    {
      "files": ["scripts/**/*.ts", "scripts/**/*.tsx", "docs/**/*.js", "docs/**/*.mjs"],
      "rules": { "security/detect-non-literal-fs-filename": "off" }
    },
    {
      "files": ["**/*.spec.ts", "**/*.spec.tsx", "tests/**", "**/test-utils/**", "setupTests.ts"],
      "plugins": ["typescript", "oxc", "unicorn", "react", "jsx-a11y", "nextjs", "import", "vitest"],
      "rules": {
        "vitest/max-nested-describe": ["error", { "max": 5 }],
        "vitest/valid-title": "off",
        "vitest/no-conditional-expect": "warn",
        "vitest/expect-expect": "warn",
        "vitest/require-mock-type-parameters": "off",
        "nextjs/no-html-link-for-pages": "off"
      }
    },
    {
      "files": [
        "src/lib/actions/**/*.ts",
        "src/lib/actions/**/*.tsx",
        "src/lib/services/**/*.ts",
        "src/lib/services/**/*.tsx",
        "src/lib/email/**/*.ts",
        "src/lib/email/**/*.tsx",
        "src/lib/repositories/**/*.ts",
        "src/lib/repositories/**/*.tsx",
        "src/app/api/**/*.ts",
        "src/app/api/**/*.tsx"
      ],
      "excludeFiles": ["**/*.spec.ts", "**/*.spec.tsx"],
      "rules": { "no-console": ["error", { "allow": [] }] }
    }
  ]
}
