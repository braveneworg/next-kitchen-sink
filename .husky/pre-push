#!/bin/sh
# Husky invokes this hook with `sh -e`, so any non-zero command aborts.
# Disable -e for the diagnostic prelude; the rest of the script handles
# its own exit codes explicitly.
set +e

# Sourced before anything else. The library performs no IO at source time — it
# only defines functions — so its position relative to the fd juggling below
# does not affect where its output lands; what matters is where its functions
# are CALLED. Sourcing here makes the diagnostic vocabulary available to the
# stdin-parsing prelude, which currently has no way to report anything.
#
# The `[ -r ]` test must precede the `.`: `.` is a POSIX special builtin, so a
# non-interactive shell exits on a read failure before any `||` on the same line
# is evaluated. Fail closed — a missing lib.sh means a broken checkout, and a
# hook that silently no-ops in that state is the exact silent-pass shape this
# repo has three lessons about.
hook_lib="$(dirname "$0")/lib.sh"
[ -r "$hook_lib" ] || {
  printf '%s\n' "husky: $hook_lib is missing or unreadable — refusing to push." >&2
  exit 1
}
. "$hook_lib"

# Log file for diagnostics (failures during `git push` can swallow hook stderr).
log_file="${TMPDIR:-/tmp}/husky-pre-push.log"
: > "$log_file"

# Names the step currently running so a failure can report *what* failed even
# before the full log is read. Updated as the hook progresses.
stage="startup"

# git invokes this hook as `pre-push <remote-name> <remote-url>` and husky
# forwards both (`sh -e "$s" "$@"` in .husky/_/h), so $1 is the remote actually
# being pushed to — which is not always "origin". Captured here, at the top,
# because the functions defined below rebind $1 to their own arguments. Falls
# back to origin when the hook is run by hand with no arguments.
push_remote="${1:-origin}"

# Capture pre-push stdin (git sends "<local ref> <local sha> <remote ref>
# <remote sha>" lines) so we can both (a) keep child processes from inheriting
# it and (b) detect a deliberate non-fast-forward (force / --force-with-lease)
# push. git does NOT pass the --force* flag to this hook, so a rewrite can only
# be inferred from these ref lines: a non-zero remote sha that is not an
# ancestor of the local sha means history is being rewritten.
push_refs=""
if [ ! -t 0 ]; then
  push_refs=$(cat 2>/dev/null || true)
fi
exec </dev/null

force_push=0
pushed_refs=0
deleted_refs=0
updates_existing_ref=0
# Names, not flags: the refusals below quote the branch back to the user.
pushed_protected=""
deleted_protected=""
if [ -n "$push_refs" ]; then
  # Heredoc (not a pipe) so the loop runs in THIS shell and force_push sticks.
  while read -r _local_ref local_sha remote_ref remote_sha; do
    # Only branches can be protected. A tag that happens to be called `main`
    # leaves this empty, and `is_protected_branch ""` is false.
    remote_branch=""
    case "$remote_ref" in refs/heads/*) remote_branch=${remote_ref#refs/heads/} ;; esac

    # An all-zero local sha is a deletion: git sends `(delete)` as the local ref
    # and there is no commit on this side at all.
    case "$local_sha" in
      *[!0]*) : ;;
      *)
        deleted_refs=$((deleted_refs + 1))
        if is_protected_branch "$remote_branch"; then
          deleted_protected="$remote_branch"
        fi
        continue
        ;;
    esac

    pushed_refs=$((pushed_refs + 1))
    # Judged by the REMOTE name. `git push origin feat/x:main` updates main
    # while a feature branch is checked out, so asking only "which branch am I
    # on?" — as this hook did — let that through.
    if is_protected_branch "$remote_branch"; then
      pushed_protected="$remote_branch"
    fi
    case "$remote_sha" in *[!0]*) : ;; *) continue ;; esac  # skip new branches
    updates_existing_ref=1
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      force_push=1
    fi
  done <<EOF
$push_refs
EOF
fi

# Every ref in this push is being CREATED on the remote (git reported an
# all-zero remote sha for each), so nothing that already exists there is being
# touched. This is a necessary condition for a seeding push, not a sufficient
# one — a deleted branch looks identical from here — so branch protection pairs
# it with an inspection of the remote below. Its value is being free: it comes
# from git's own push negotiation and short-circuits the network check for
# ordinary pushes. With no ref lines on stdin (the hook run by hand) nothing can
# be told apart, so the stricter path stands.
seeding_push=0
if [ "$pushed_refs" -gt 0 ] && [ "$updates_existing_ref" = "0" ]; then
  seeding_push=1
fi

# When invoked by `git push`, git exports GIT_* env vars that can confuse
# child git commands (fetch, rev-parse, diff). Unset them so internal git
# calls behave like a normal CLI invocation.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_OBJECT_DIRECTORY 2>/dev/null
unset GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_QUARANTINE_PATH 2>/dev/null
unset GIT_INTERNAL_GETTEXT_SH_SCHEME GIT_REFLOG_ACTION GIT_EDITOR 2>/dev/null

# Preserve the ORIGINAL stderr on fd 3 *before* we redirect our own output to
# the log file. git relays a hook's stderr to whatever launched the push
# (terminal, VS Code, a GUI client); after the redirect below our fd 2 points
# at the log instead, so the cleanup trap surfaces failures by writing to fd 3.
exec 3>&2

# Redirect all output to the log file; tail it to /dev/tty when one is
# available so progress is visible live during an interactive CLI push.
exec >>"$log_file" 2>&1
tty_shown=0
if [ -e /dev/tty ] && { : >>/dev/tty; } 2>/dev/null; then
  tail -f "$log_file" >/dev/tty 2>/dev/null &
  tail_pid=$!
  tty_shown=1
fi

# Single cleanup path for every exit. Stops the live tail and, on failure,
# surfaces the diagnostics on the original stderr (fd 3) so the reason is
# visible even when there is NO TTY — e.g. pushing from the VS Code Source
# Control panel or a GUI client, where the live tail never ran and git
# otherwise only shows its own generic "failed to push some refs".
cleanup() {
  rc=$?
  if [ -n "${tail_pid:-}" ]; then
    # Let the tail flush its final lines before we kill it on failure.
    [ "$rc" -ne 0 ] && sleep 1
    kill "$tail_pid" 2>/dev/null
  fi
  if [ "$rc" -ne 0 ]; then
    {
      echo ""
      echo "❌ pre-push hook failed during: $stage (exit code $rc)"
      echo "   Full log: $log_file"
      # When the output was already streamed to a TTY, don't repeat the whole
      # log — just the headline above. Otherwise replay it so non-TTY clients
      # (VS Code / GUI) get the actual reason, not just a generic git error.
      if [ "$tty_shown" -eq 0 ]; then
        echo "   ----------------------- hook output -----------------------"
        sed 's/^/   | /' "$log_file" 2>/dev/null
        echo "   -----------------------------------------------------------"
      fi
    } >&3 2>/dev/null
  fi
  exit $rc
}
# shellcheck disable=SC2064
trap cleanup EXIT INT TERM

echo ""
echo "===== pre-push hook started at $(date) ====="

# `remote_state` now lives in .husky/lib.sh, next to `fetch_branch`. The two
# used to sit 80 lines apart here with opposite numeric conventions — 1 meant
# "has refs" in one and "network failure" in the other — which is the recurring
# class docs/lessons/git-workflow/pre-push-deadlocked-a-fresh-remote.md names.
# They answer in named tokens now, which cannot be transposed.

# A push made only of deletions carries no commits: there is no tree to
# type-check, lint or test, and "is this branch behind?" has no branch to ask
# about. Nothing below can say anything useful, and from main the branch check
# would refuse outright — which made tidying up a merged branch impossible
# without first checking out some other branch.
#
# Settled before branch protection for that reason, and the protected-branch
# refusal comes first so the exemption cannot be used to delete main.
stage="ref deletion"
if [ -n "$deleted_protected" ]; then
  refuse "Deleting '$deleted_protected' on '$push_remote' is not allowed."
fi
if [ "$deleted_refs" -gt 0 ] && [ "$pushed_refs" = "0" ]; then
  echo "🗑️  Only deleting refs on '$push_remote' — no commits are being pushed, so there is nothing to check."
  exit 0
fi

# Prevent pushing directly to main or master branches. The one exception is
# seeding an *entirely unseeded* remote, which would otherwise have no legal
# first push at all: refusing every push from main, while every other branch is
# measured against an origin/main that does not exist yet, is a deadlock.
#
# "This branch is missing from the remote" is deliberately NOT enough — deleting
# main on the forge would re-open direct pushes to it forever after. The all-zero
# remote sha on stdin cannot tell an unseeded repository from a deleted branch,
# so the remote itself is inspected. That check is gated behind $seeding_push
# (which is free) so an ordinary accidental push to main is still rejected
# without paying for a network round trip.
#
# Two independent questions decide whether this is a push to a protected branch,
# and either one is enough:
#
#   - Is a protected branch checked out? Everything below — the commit count,
#     the WIP scan, the gate — measures HEAD, so a push made from main is
#     treated as a push of main whatever the refspec says. That is deliberately
#     strict: allowing `git push origin feat/x` from main would gate main's tree
#     and send feat/x's commits unexamined.
#   - Does a ref line name a protected branch on the remote? That catches
#     `git push origin feat/x:main`, which the first question cannot see.
stage="branch protection"
# `current_branch`, not `git rev-parse --abbrev-ref HEAD`. The comment at
# .husky/pre-commit:11-15 spells out why rev-parse is wrong here — it exits 128
# on an unborn branch — and this hook used exactly the call that comment
# forbids. The library keeps rev-parse only as a fallback, so a detached HEAD
# still reports "HEAD" and the messages below read the same.
branch_name=$(current_branch)
protected_refusal=""
if is_protected_branch "$branch_name"; then
  protected_refusal="You are on the '$branch_name' branch. Pushing directly to this branch is not allowed."
elif [ -n "$pushed_protected" ]; then
  protected_refusal="This push updates '$pushed_protected' on '$push_remote'. Pushing directly to this branch is not allowed."
fi
if [ -n "$protected_refusal" ]; then
  seeding_allowed=0
  if [ "$seeding_push" = "1" ]; then
    # The `*)` arm is deliberately the strict one: a token this hook does not
    # recognise must fail closed, not fall through to "allowed".
    case "$(remote_state "$push_remote")" in
      empty) seeding_allowed=1 ;;
      populated) : ;;
      *)
        # Never let an unreachable remote read as an unseeded one — that would
        # turn a network blip into an unlocked main.
        fail "Could not reach '$push_remote' to check whether it is unseeded." \
          "Please check your network connection and try again."
        ;;
    esac
  fi

  if [ "$seeding_allowed" = "1" ]; then
    echo "🌱 '$push_remote' has no refs at all — allowing this push to seed it."
  else
    refuse "$protected_refusal"
  fi
fi

# Resolve the branch's configured upstream (e.g. "origin/feature-x"). If the
# branch has no upstream yet (first push), fall back to comparing against
# origin/main so first-push branches still get the same safety checks.
#
# Note: on modern git, when no upstream is configured, `rev-parse` exits 128
# AND prints the literal string '@{u}' to stdout. Gate on the exit code so we
# don't capture that literal as if it were a real ref.
stage="upstream resolution"
if upstream_ref=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null); then
  :
else
  upstream_ref=""
fi
if [ -z "$upstream_ref" ]; then
  echo "ℹ️  No upstream configured for '$branch_name' — comparing against 'origin/main'."
  has_upstream=0
  sync_ref="origin/main"
  sync_remote="origin"
  sync_branch="main"
else
  has_upstream=1
  sync_ref="$upstream_ref"
  sync_remote=${upstream_ref%%/*}
  sync_branch=${upstream_ref#*/}
fi

# Skip if there's nothing to push (no commits ahead of the sync ref).
# Use rev-list to count commits, not diff (which compares trees and misses
# merge commits that don't change file content relative to the ref).
commits_ahead=$(git rev-list --count "$sync_ref"..HEAD 2>/dev/null || echo "unknown")
if [ "$commits_ahead" = "0" ]; then
  echo "Nothing to push, skipping pre-push checks."
  exit 0
fi

# `fetch_branch` lives in .husky/lib.sh — see the note beside the branch check
# above for why both remote helpers moved there together.

# Fetch the sync ref so the comparisons below are against the latest remote
# state. For first-push branches this fetches origin/main; for tracked
# branches it fetches the actual upstream (avoids false "behind" results
# for non-main upstreams). This runs BEFORE the WIP scan so that scan compares
# against fresh remote state rather than a stale local copy of it.
stage="fetch $sync_ref"
no_baseline=0
fetch_state=$(fetch_branch "$sync_remote" "$sync_branch")

if [ "$fetch_state" = "absent" ] && [ "$has_upstream" = "1" ]; then
  # The branch we track no longer exists remotely (commonly: it was merged and
  # the remote branch tidied up), so there's nothing to be "behind" — push to
  # re-create it. Keep the safety checks by falling back to comparing against
  # origin/main, exactly like a brand-new branch.
  info "Upstream '$sync_ref' no longer exists on '$sync_remote' (branch deleted)." \
    "Falling back to 'origin/main' and pushing to re-create the branch."
  has_upstream=0
  sync_ref="origin/main"
  sync_remote="origin"
  sync_branch="main"
  stage="fetch $sync_ref"
  fetch_state=$(fetch_branch "$sync_remote" "$sync_branch")
fi

# `*)` is the strict arm on purpose — an unrecognised token must fail the push
# rather than be read as a successful fetch.
case "$fetch_state" in
  fetched) ;;
  absent)
    # The remote is reachable but has no such branch — an empty repository, or
    # one whose main has yet to be seeded. There is no baseline to measure this
    # push against, so the sync comparisons are skipped below. The gate itself
    # runs regardless, as it does for every push that carries commits.
    no_baseline=1
    info "'$sync_ref' does not exist on '$sync_remote' yet — nothing to compare against."
    ;;
  *)
    fail "Failed to fetch latest changes from $sync_ref." "Please check your network connection and try again."
    ;;
esac

# Block pushing WIP / fixup! / squash! commits — these should be rebased away
# before review. Match against the subject line of each commit ahead of the
# sync ref, or of every commit when there is no sync ref to be ahead of.
stage="WIP/fixup commit scan"
if [ "$no_baseline" = "1" ]; then
  wip_range="HEAD"
  wip_rebase_onto="--root"
else
  wip_range="$sync_ref..HEAD"
  wip_rebase_onto="$sync_ref"
fi
wip_subjects=$(git log "$wip_range" --pretty=%s | grep -iE '^(wip([: ]|$)|fixup!|squash!)' || true)
if [ -n "$wip_subjects" ]; then
  echo "🚫 Refusing to push: WIP / fixup! / squash! commits present:"
  printf '   - %s\n' "$wip_subjects"
  echo ""
  echo "   Rebase to clean these up:  git rebase -i $wip_rebase_onto --autosquash"
  exit 1
fi

# If local branch is genuinely behind the sync ref, prevent push and tell
# the user to merge it in first. For new branches this means merging
# origin/main; for tracked branches it means rebasing onto the upstream.
stage="up-to-date check against $sync_ref"
if [ "$no_baseline" = "1" ]; then
  echo "⏭️  No baseline on '$sync_remote' — skipping the up-to-date check."
elif ! git merge-base --is-ancestor "$sync_ref" HEAD; then
  if [ "$force_push" = "1" ]; then
    echo "⚠️  '$sync_ref' is not an ancestor of HEAD, but this is a force push"
    echo "    (e.g. --force-with-lease after a rebase) — skipping the up-to-date"
    echo "    check. Type-check, lint, format, and tests still run below."
  elif [ "$has_upstream" = "1" ]; then
    echo "🚫 Your local branch is behind '$sync_ref'."
    echo "   Run: git pull --rebase $sync_remote $sync_branch"
    exit 1
  else
    echo "🚫 Your branch '$branch_name' is missing commits from '$sync_ref'."
    echo "   Merge the latest main in before pushing:"
    echo "   git merge $sync_ref"
    echo "   (or: git pull --rebase $sync_remote $sync_branch)"
    exit 1
  fi
fi

# Every push that reaches this point runs the full gate. There is deliberately
# no "nothing relevant changed" shortcut.
#
# There used to be one: the gate was skipped unless a `.ts` or `.tsx` file
# differed from the sync ref. It assumed every other file was inert, and almost
# none are. `pnpm-lock.yaml` and `package.json` decide what the compiler and the
# tests resolve; the coverage gate parses COVERAGE_METRICS.md; Prettier checks
# Markdown, JSON and CSS; the hook specs execute `.husky/*`. A dependency bump —
# the change most likely to break types or tests without touching a line of
# source — was pushed with nothing run at all, under a message that read like a
# considered decision.
#
# No narrower rule replaces it, because a list of "files no gate reads" is a
# claim about every test and tool in the repository that nothing verifies and
# that goes stale silently. Pushes that have nothing to check are already
# settled above: a delete-only push, and a branch with no commits ahead.
# See docs/lessons/tooling/pre-push-judged-the-push-by-proxies.md.

# Each gate is announced, run and judged by `run_gate` (see .husky/lib.sh).
# These four blocks were previously 14 near-identical lines apiece, and the only
# information any of them carried beyond the command name was the typecheck
# rationale below. The command is passed as real argv, so nothing can be
# appended to it the way `--reporter=dot --silent` once was.
#
# `stage` stays inline: it is read by the EXIT trap to name what was running,
# and its strings are deliberately more specific than the labels.

# `pnpm run typecheck`, not a bare `tsc --noEmit`: typecheck runs `next typegen`
# first, and PageProps/LayoutProps are generated globals that layout.tsx and
# page.tsx reference. Calling tsc directly fails on any clone that has not yet
# run a dev server or build. Invoking the script also keeps this hook and the
# documented gate from drifting apart.
stage="TypeScript type-check (pnpm run typecheck)"
run_gate "TypeScript type-check" "" pnpm run typecheck

echo ""
stage="oxlint (pnpm run lint)"
run_gate "oxlint" "" pnpm run lint

echo ""
stage="Prettier format check (pnpm run format:check)"
run_gate "Prettier format check" "pnpm run format" pnpm run format:check

echo ""
stage="tests + coverage (pnpm run test:coverage:check)"
# No run-args here. pnpm appends them to the END of the script string, and
# `test:coverage:check` is `vitest run --coverage && tsx check-coverage-regression.ts`,
# so `--reporter=dot --silent` landed on the tsx invocation, which ignores
# unknown argv. The flags never reached vitest and never suppressed anything;
# they only read like configuration. Verbosity is already handled by
# `silent: 'passed-only'` in vitest.config.ts.
run_gate "tests" "pnpm run test" pnpm run test:coverage:check

echo "🚀 Pushing changes..."

exit 0
