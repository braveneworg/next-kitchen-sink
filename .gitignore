# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.vitest-reports
test-results.xml

# Temporary TypeScript config files generated during testing (e.g., tsconfig.abc123xyz.json)
tsconfig.*.json
!tsconfig.test.json

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (NEVER commit these)
.env
.env.local
.env.development
.env.production
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated architecture docs — kept locally, never committed
# (regenerate with docs/architectural-diagrams/build-pdf.js)
/docs/architectural-diagrams/

.claude/*
!.claude/settings.json


# AI agent configs
.agents/

package-lock.json
